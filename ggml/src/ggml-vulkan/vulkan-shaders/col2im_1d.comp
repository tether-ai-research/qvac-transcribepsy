#version 450

#include "types.glsl"

// col2im_1d: scatter-add GEMM columns back to a 1D signal (GEMM-based
// conv_transpose_1d, ACE-Step Oobleck VAE).  Columns [K*OC, T_in] -> signal
// [T_out, OC], with T_out = (T_in - 1)*s0 + K - 2*p0.  Implemented as a gather:
// each output (t_out, oc) reads the (<= ceil(K/s0)) columns that land on it, so
// threads write disjoint outputs and no atomics are needed.  One thread per
// output element.  F32 only.
layout (push_constant) uniform parameter
{
    uint T_out;
    uint OC;
    uint K;
    uint T_in;
    uint K_OC;   // K*OC == src ne0
    int  s0;     // stride
    int  p0;     // padding cropped from both sides
} p;

layout (binding = 0) readonly  buffer A {float data_a[];};   // columns [K*OC, T_in]
layout (binding = 1) writeonly buffer D {float data_d[];};   // signal  [T_out, OC]

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint gid = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
    if (gid >= p.T_out * p.OC) {
        return;
    }

    const uint t_out = gid % p.T_out;
    const uint oc    = gid / p.T_out;

    const int t_abs = int(t_out) + p.p0;   // position in the uncropped signal

    // Gather every (t_in, k) with t_in*s0 + k == t_abs, 0 <= k < K.
    int t_in_min = (t_abs - int(p.K) + 1 + p.s0 - 1) / p.s0;   // ceil((t_abs-K+1)/s0)
    if (t_in_min < 0) {
        t_in_min = 0;
    }
    int t_in_max = t_abs / p.s0;
    if (t_in_max >= int(p.T_in)) {
        t_in_max = int(p.T_in) - 1;
    }

    float sum = 0.0f;
    for (int t_in = t_in_min; t_in <= t_in_max; ++t_in) {
        const int k = t_abs - t_in * p.s0;
        if (k >= 0 && k < int(p.K)) {
            sum += data_a[(oc * p.K + uint(k)) + uint(t_in) * p.K_OC];
        }
    }

    data_d[t_out + oc * p.T_out] = sum;
}
